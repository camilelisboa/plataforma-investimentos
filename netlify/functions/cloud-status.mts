import type { Config, Context } from "@netlify/functions";
import { getDatabase } from "@netlify/database";
import { getSessionUser } from "../lib/auth.js";
import { getPortfolioForUser } from "../lib/data.js";
import { json } from "../lib/http.js";
export default async(req:Request,_context:Context)=>{if(req.method!=="GET")return json({error:'Método não permitido.'},405);const user=await getSessionUser(req);if(!user)return json({error:'Sessão expirada.'},401);const db=getDatabase();const portfolio=await getPortfolioForUser(user);const [dep,settings,backup,sessions,snapshot]=await Promise.all([db.sql`SELECT setup_completed_at,release_version FROM deployment_state WHERE id=1 LIMIT 1` as any,db.sql`SELECT auto_backup_enabled,backup_frequency FROM user_security_settings WHERE user_id=${user.id} LIMIT 1` as any,db.sql`SELECT label,created_at,backup_kind FROM account_backups WHERE user_id=${user.id} ORDER BY created_at DESC,id DESC LIMIT 1` as any,db.sql`SELECT COUNT(*)::int AS count FROM sessions WHERE user_id=${user.id} AND expires_at>NOW()` as any,portfolio?db.sql`SELECT snapshot_date,updated_at FROM portfolio_snapshots WHERE portfolio_id=${Number(portfolio.id)} ORDER BY snapshot_date DESC,id DESC LIMIT 1` as any:Promise.resolve([] as any)]);const url=new URL(req.url);const host=req.headers.get('host')||url.host;return json({version:dep[0]?.release_version||'2.4.0',round:36,environment:host.includes('localhost')?'local':'production',published:!host.includes('localhost'),https:url.protocol==='https:',database:true,sessionServerSide:true,setupComplete:Boolean(dep[0]?.setup_completed_at),scheduledBackups:true,siteUrl:`${url.protocol}//${host}`,activeSessions:Number(sessions[0]?.count||0),portfolioReady:Boolean(portfolio),lastBackupAt:backup[0]?.created_at||null,lastBackupLabel:backup[0]?`${backup[0].label}${backup[0].backup_kind==='AUTOMATIC'?' · automático':''}`:null,backupFrequency:settings[0]?.backup_frequency||'WEEKLY',automaticBackupEnabled:settings[0]?.auto_backup_enabled!==false,latestSnapshotAt:snapshot[0]?.updated_at||snapshot[0]?.snapshot_date||null,dataIsolation:true});};
export const config:Config={path:'/api/cloud-status'};
