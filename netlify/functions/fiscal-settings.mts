import type { Config, Context } from "@netlify/functions";
import { getDatabase } from "@netlify/database";
import { getSessionUser } from "../lib/auth.js";
import { asNumber, getPortfolioForUser, logActivity } from "../lib/data.js";
import { json } from "../lib/http.js";
const serialize=(r:any)=>({stockExemption:asNumber(r?.stock_exemption,20000),commonRate:asNumber(r?.common_rate,15),dayTradeRate:asNumber(r?.day_trade_rate,20),fiiRate:asNumber(r?.fii_rate,20)});
export default async(req:Request,_c:Context)=>{const user=await getSessionUser(req);if(!user)return json({error:"Sessão expirada."},401);const p=await getPortfolioForUser(user);if(!p)return json({error:"Carteira não encontrada."},404);const db=getDatabase(),pid=Number(p.id);if(req.method==="GET"){const rows=await db.sql`SELECT * FROM fiscal_settings WHERE portfolio_id=${pid} LIMIT 1`;return json({settings:serialize(rows[0])});}if(req.method!=="PUT")return json({error:"Método não permitido."},405);let b:any;try{b=await req.json()}catch{return json({error:"Dados inválidos."},400)}const s={stockExemption:asNumber(b.stockExemption,20000),commonRate:asNumber(b.commonRate,15),dayTradeRate:asNumber(b.dayTradeRate,20),fiiRate:asNumber(b.fiiRate,20)};const rows=await db.sql`INSERT INTO fiscal_settings(portfolio_id,stock_exemption,common_rate,day_trade_rate,fii_rate,updated_at) VALUES(${pid},${s.stockExemption},${s.commonRate},${s.dayTradeRate},${s.fiiRate},NOW()) ON CONFLICT(portfolio_id) DO UPDATE SET stock_exemption=EXCLUDED.stock_exemption,common_rate=EXCLUDED.common_rate,day_trade_rate=EXCLUDED.day_trade_rate,fii_rate=EXCLUDED.fii_rate,updated_at=NOW() RETURNING *`;await logActivity(pid,"updated","fiscal","Parâmetros fiscais",s);return json({settings:serialize(rows[0])});};
export const config:Config={path:"/api/fiscal-settings"};
