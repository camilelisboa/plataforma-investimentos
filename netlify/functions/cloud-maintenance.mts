import type { Config } from "@netlify/functions";
import { getDatabase } from "@netlify/database";
import { createUserBackup } from "../lib/vault.js";
function periodKey(freq:string,d=new Date()){const y=d.getUTCFullYear(),m=String(d.getUTCMonth()+1).padStart(2,'0');if(freq==='DAILY')return `D:${d.toISOString().slice(0,10)}`;if(freq==='MONTHLY')return `M:${y}-${m}`;const start=new Date(Date.UTC(y,0,1));const day=Math.floor((d.getTime()-start.getTime())/86400000);const week=String(Math.floor((day+start.getUTCDay())/7)+1).padStart(2,'0');return `W:${y}-${week}`}
export default async()=>{const db=getDatabase();await db.sql`DELETE FROM sessions WHERE expires_at<=NOW()`;const rows=await db.sql`SELECT u.id,u.login_key,u.display_name,u.theme,u.must_change_password,s.auto_backup_enabled,s.backup_frequency,p.id AS portfolio_id,p.name,p.currency,p.last_rebalance_amount,p.benchmark_symbol,p.tracking_start_date,p.rebalance_tolerance_pct,p.updated_at FROM users u JOIN user_security_settings s ON s.user_id=u.id JOIN portfolios p ON p.user_id=u.id WHERE s.auto_backup_enabled=TRUE` as any[];for(const row of rows){const key=periodKey(row.backup_frequency||'WEEKLY');const label=`Backup automático · ${key.slice(2)}`;const result=await createUserBackup(row,{id:row.portfolio_id,name:row.name,currency:row.currency,last_rebalance_amount:row.last_rebalance_amount,benchmark_symbol:row.benchmark_symbol,tracking_start_date:row.tracking_start_date,rebalance_tolerance_pct:row.rebalance_tolerance_pct,updated_at:row.updated_at},label,'AUTOMATIC',key);if(result.created)await db.sql`INSERT INTO security_audit(user_id,event_type,detail,user_agent) VALUES(${row.id},'BACKUP_CREATED',${label},'Scheduled cloud maintenance')`;}};
export const config:Config={schedule:'0 6 * * *'};
